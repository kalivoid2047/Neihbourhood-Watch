# .env.example — copy to .env and fill in your values.
# All Docker-specific hostnames (e.g. "postgres", "redis") have been replaced
# with localhost defaults so this file works for both native and Docker deploys.

# ============================================================================
# Django Settings
# ============================================================================

# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-super-secret-key-here-change-in-production

# NEVER True in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# Database
# ============================================================================

# Native / local PostgreSQL
DATABASE_URL=postgresql://nhwz:nhwz@localhost:5432/nhwz

# ============================================================================
# Redis
# ============================================================================

# Native / local Redis
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Storage
# ============================================================================

# Set True to route all media uploads through MinIO or S3.
# False = files are stored on the local filesystem under MEDIA_ROOT.
USE_S3_STORAGE=False
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=nhwz
MINIO_SECRET_KEY=nhwz-secret
MINIO_BUCKET_NAME=nhwz-media

# ============================================================================
# Email  (OTP codes and notifications)
# ============================================================================

# Use console backend in development (prints emails to the terminal).
# Switch to smtp.EmailBackend in production and fill in the SMTP fields.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# ============================================================================
# OTP
# ============================================================================

OTP_EXPOSE_DEBUG_CODES=True   # set False in production
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ============================================================================
# JWT
# ============================================================================

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Celery
# ============================================================================

CELERY_TASK_ALWAYS_EAGER=False

# ============================================================================
# Nginx
# ============================================================================

# Where nginx should proxy API traffic to.
# Docker default:  api:8000  (service name resolved by Docker's internal DNS)
# Native default:  127.0.0.1:8000
NHWZ_API_HOST=127.0.0.1:8000

# Filesystem paths for static / media files served directly by nginx.
# Docker default:  /staticfiles/  and  /media/  (volume mount paths)
# Native: set to your Django STATIC_ROOT and MEDIA_ROOT directories.
NHWZ_STATIC_PATH=/opt/nhwz/staticfiles/
NHWZ_MEDIA_PATH=/opt/nhwz/media/

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=INFO

# ============================================================================
# Security  (production only — leave these unset or False in local dev)
# ============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ============================================================================
# Monitoring
# ============================================================================

SENTRY_DSN=
APP_VERSION=8.0.0
DJANGO_ENV=local

# ============================================================================
# Frontend (Vite)
# ============================================================================

# Use 127.0.0.1 (not localhost): on Windows localhost resolves to IPv6 first and may
# reach a different local service on :8000 instead of Django.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Map tiles. Unset = public OpenStreetMap tiles (development only).
# Stadia Maps (free tier is for non-commercial use; paid plans for commercial):
#   1. Create a property at https://client.stadiamaps.com and add your production
#      domain under "Authentication" (domain auth needs no key in the URL, and
#      localhost works without one), OR generate an API key and append
#      ?api_key=YOUR_KEY to both URLs below. Restrict the key to your domain.
# VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
# VITE_MAP_TILE_URL_NIGHT=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/" target="_blank">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/" target="_blank">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_APP_NAME=Neighbourhood Watch Zimbabwe
VITE_APP_VERSION=0.2.0

# ============================================================================
# Push notifications (Firebase Cloud Messaging) — mobile app
# ============================================================================
# FCM only *delivers* messages; it stores nothing and replaces nothing.
# Without it the mobile app still alarms, but only on its own polling
# schedule — up to ~15 minutes late when the app is backgrounded.
# Full walkthrough: docs/FIREBASE_SETUP.md
#
# FCM_CREDENTIALS_FILE points at a Firebase service-account JSON key. Treat it
# like a database password: never commit it, and restrict it to the service
# user (chmod 600). Anyone holding it can push to every user of the app.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# ============================================================================
# Incident alerting
# ============================================================================
# Fallback alert radius in metres, used when an incident has no neighbourhood
# (and therefore no Neighborhood.alert_radius_m to read).
INCIDENT_ALERT_DEFAULT_RADIUS_M=5000

# Severities that alert neighbours the moment they are reported, before a
# coordinator verifies them. Everything else waits for verification.
# Trade-off: faster warnings vs. more false alarms. This is a community-policy
# decision. Set to an empty value to require verification for everything.
INCIDENT_ALERT_ON_CREATE_SEVERITIES=red

# ============================================================================
# Mobile app (Flutter) — build-time, passed via --dart-define, not read here
# ============================================================================
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
# 10.0.2.2 is the Android emulator's route to the host's localhost. For a
# physical device use the machine's LAN address and add it to
# DJANGO_ALLOWED_HOSTS above.
